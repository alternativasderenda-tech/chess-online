# Xadrez online (servidor próprio; antes Vercel + Supabase). Incluído no fim do /etc/caddy/Caddyfile — não muda o
# bloco do energiawatt.com. API (PostgREST), login (GoTrue) e tempo real ficam só em 127.0.0.1, atrás daqui.
xadrezonline.app {
	encode zstd gzip
	handle_path /rest/v1/* {
		reverse_proxy 127.0.0.1:3201
	}
	handle_path /auth/v1/* {
		reverse_proxy 127.0.0.1:9999
	}
	handle /xrt* {
		reverse_proxy 127.0.0.1:3202
	}
	handle /functions/v1/* {
		reverse_proxy 127.0.0.1:3202
	}
	handle /pagamentos/* {
		reverse_proxy 127.0.0.1:3202
	}
	handle /t/* {
		reverse_proxy 127.0.0.1:3202
	}
	handle {
		root * /opt/xadrez/site
		# /en/tournaments = a página de torneios em inglês (mesmo arquivo; o idioma sai da URL)
		rewrite /en/tournaments /torneios.html
		rewrite /en /
		try_files {path} {path}.html {path}/index.html
		header Cache-Control "public, max-age=3600"
		@img path *.png *.jpg *.jpeg *.svg *.webp *.ico *.woff *.woff2
		header @img Cache-Control "public, max-age=86400, immutable"
		@semcache path / /sw.js /config.js /privacidade /termos /torneios /en/tournaments *.html
		header @semcache Cache-Control "public, max-age=0, must-revalidate"
		file_server
	}
}


novo.xadrezonline.app {
	encode zstd gzip
	# ambiente de TESTE (banco xadrez_teste): fora do Google
	header X-Robots-Tag "noindex, nofollow"
	handle_path /rest/v1/* {
		reverse_proxy 127.0.0.1:3211
	}
	handle_path /auth/v1/* {
		reverse_proxy 127.0.0.1:9909
	}
	handle /xrt* {
		reverse_proxy 127.0.0.1:3212
	}
	handle /functions/v1/* {
		reverse_proxy 127.0.0.1:3212
	}
	handle /pagamentos/* {
		reverse_proxy 127.0.0.1:3212
	}
	handle /t/* {
		reverse_proxy 127.0.0.1:3212
	}
	handle {
		root * /opt/xadrez/site-teste
		# /en/tournaments = a página de torneios em inglês (mesmo arquivo; o idioma sai da URL)
		rewrite /en/tournaments /torneios.html
		rewrite /en /
		try_files {path} {path}.html {path}/index.html
		header Cache-Control "public, max-age=3600"
		@img path *.png *.jpg *.jpeg *.svg *.webp *.ico *.woff *.woff2
		header @img Cache-Control "public, max-age=86400, immutable"
		@semcache path / /sw.js /config.js /privacidade /termos /torneios /en/tournaments *.html
		header @semcache Cache-Control "public, max-age=0, must-revalidate"
		file_server
	}
}

www.xadrezonline.app {
	redir https://xadrezonline.app{uri} permanent
}
