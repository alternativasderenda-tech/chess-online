# Xadrez online (servidor próprio; antes Vercel + Supabase). Incluído no fim do /etc/caddy/Caddyfile — não muda o
# bloco do energiawatt.com. API (PostgREST), login (GoTrue) e tempo real ficam só em 127.0.0.1, atrás daqui.
xadrezonline.app {
	encode zstd gzip
	handle_path /rest/v1/* {
		reverse_proxy 127.0.0.1:3201
	}
	handle_path /auth/v1/* {
		reverse_proxy 127.0.0.1:9999
	}
	handle /xrt* {
		reverse_proxy 127.0.0.1:3202
	}
	handle /functions/v1/* {
		reverse_proxy 127.0.0.1:3202
	}
	handle /pagamentos/* {
		reverse_proxy 127.0.0.1:3202
	}
	handle /t/* {
		reverse_proxy 127.0.0.1:3202
	}
	handle /en/t/* {
		reverse_proxy 127.0.0.1:3202
	}
	handle {
		root * /opt/xadrez/site
		# URL única (D-APR-14; o Vercel fazia isso com cleanUrls): /x.html, /pasta/index.html, /pasta/index e /pasta/ dão
		# 301 para a URL limpa, mantendo a query. Na ordem do Caddy, redir roda antes de rewrite e try_files, então não há
		# laço. Os handle de cima (/rest, /auth, /xrt, /functions, /pagamentos, /t/, /en/t/) nem passam por aqui. Ficam de
		# fora /index.html (o sw.js o pré-carrega) e /404.html.
		@html {
			path_regexp html ^(/.+?)(?:/index)?\.html$
			not path /index.html /404.html
		}
		redir @html {re.html.1}{?query} permanent
		@indice path_regexp indice ^(/.+)/index$
		redir @indice {re.indice.1}{?query} permanent
		redir /index /{?query} permanent
		@barra path_regexp barra ^(/.+)/$
		redir @barra {re.barra.1}{?query} permanent
		# /en/tournaments = a página de torneios em inglês (mesmo arquivo; o idioma sai da URL)
		rewrite /en/tournaments /torneios.html
		rewrite /en /
		try_files {path} {path}.html {path}/index.html
		# "?" = só se ninguém definiu antes: sem ele, este padrão (sem matcher) roda por último e anula o @semcache
		header ?Cache-Control "public, max-age=3600"
		@img path *.png *.jpg *.jpeg *.svg *.webp *.ico *.woff *.woff2
		header @img Cache-Control "public, max-age=86400, immutable"
		@semcache path / /sw.js /config.js /privacidade /termos /torneios /en/tournaments *.html
		header @semcache Cache-Control "public, max-age=0, must-revalidate"
		# CSS/JS do Aprenda com ?v=<hash do conteúdo> (D-APR-08): o endereço muda quando o arquivo muda (LAY-desempenho-18)
		@versionado query v=*
		header @versionado Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	# 404 (D-APR-09): página bilíngue com links para o jogo, o Aprenda e os torneios, com status 404 de verdade
	handle_errors {
		@nao_existe expression `{err.status_code} == 404`
		handle @nao_existe {
			root * /opt/xadrez/site
			header Cache-Control "public, max-age=0, must-revalidate"
			rewrite * /404.html
			file_server {
				status 404
			}
		}
	}
}


novo.xadrezonline.app {
	encode zstd gzip
	# ambiente de TESTE (banco xadrez_teste): fora do Google
	header X-Robots-Tag "noindex, nofollow"
	handle_path /rest/v1/* {
		reverse_proxy 127.0.0.1:3211
	}
	handle_path /auth/v1/* {
		reverse_proxy 127.0.0.1:9909
	}
	handle /xrt* {
		reverse_proxy 127.0.0.1:3212
	}
	handle /functions/v1/* {
		reverse_proxy 127.0.0.1:3212
	}
	handle /pagamentos/* {
		reverse_proxy 127.0.0.1:3212
	}
	handle /t/* {
		reverse_proxy 127.0.0.1:3212
	}
	handle /en/t/* {
		reverse_proxy 127.0.0.1:3212
	}
	handle {
		root * /opt/xadrez/site-teste
		# URL única (D-APR-14; o Vercel fazia isso com cleanUrls): /x.html, /pasta/index.html, /pasta/index e /pasta/ dão
		# 301 para a URL limpa, mantendo a query. Na ordem do Caddy, redir roda antes de rewrite e try_files, então não há
		# laço. Os handle de cima (/rest, /auth, /xrt, /functions, /pagamentos, /t/, /en/t/) nem passam por aqui. Ficam de
		# fora /index.html (o sw.js o pré-carrega) e /404.html.
		@html {
			path_regexp html ^(/.+?)(?:/index)?\.html$
			not path /index.html /404.html
		}
		redir @html {re.html.1}{?query} permanent
		@indice path_regexp indice ^(/.+)/index$
		redir @indice {re.indice.1}{?query} permanent
		redir /index /{?query} permanent
		@barra path_regexp barra ^(/.+)/$
		redir @barra {re.barra.1}{?query} permanent
		# /en/tournaments = a página de torneios em inglês (mesmo arquivo; o idioma sai da URL)
		rewrite /en/tournaments /torneios.html
		rewrite /en /
		try_files {path} {path}.html {path}/index.html
		# "?" = só se ninguém definiu antes: sem ele, este padrão (sem matcher) roda por último e anula o @semcache
		header ?Cache-Control "public, max-age=3600"
		@img path *.png *.jpg *.jpeg *.svg *.webp *.ico *.woff *.woff2
		header @img Cache-Control "public, max-age=86400, immutable"
		@semcache path / /sw.js /config.js /privacidade /termos /torneios /en/tournaments *.html
		header @semcache Cache-Control "public, max-age=0, must-revalidate"
		# CSS/JS do Aprenda com ?v=<hash do conteúdo> (D-APR-08): o endereço muda quando o arquivo muda (LAY-desempenho-18)
		@versionado query v=*
		header @versionado Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	# 404 (D-APR-09): página bilíngue com links para o jogo, o Aprenda e os torneios, com status 404 de verdade
	handle_errors {
		@nao_existe expression `{err.status_code} == 404`
		handle @nao_existe {
			root * /opt/xadrez/site-teste
			header X-Robots-Tag "noindex, nofollow"
			header Cache-Control "public, max-age=0, must-revalidate"
			rewrite * /404.html
			file_server {
				status 404
			}
		}
	}
}

www.xadrezonline.app {
	redir https://xadrezonline.app{uri} permanent
}
